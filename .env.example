# =============================================================================
# AI Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Service ---
SERVICE_NAME=mock-ai-service
VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # json | text
LOG_FILE_PATH=logs/ai-service.log
LOG_OVERWRITE_ON_START=true      # true overwrites on each app start

# --- API ---
API_V1_PREFIX=/v1
ENABLE_DOCS=true

# --- Files Service ---
FILES_SERVICE_BASE_URL=https://mock-files-gateway.example.com
FILES_SERVICE_DOWNLOAD_PATH_TEMPLATE=/files/api/v1/files/{file_id}
FILES_SERVICE_UPLOAD_URL_PATH=/files/api/v1/files/upload-url
FILES_SERVICE_AUTH_TOKEN=mock_files_service_token
FILES_SERVICE_TIMEOUT_SECONDS=20
FILES_SERVICE_VERIFY_TLS=true
FILES_SERVICE_UPLOAD_BUCKET=AI_DOCUMENTS

# --- Uploaded files processing limits ---
FILES_MAX_COUNT=10
FILES_MAX_SIZE_BYTES=8388608
FILES_MAX_EXTRACTED_CHARS_PER_FILE=15000
FILES_MAX_EXTRACTED_TOTAL_CHARS=50000

# --- AI / LLM ---
GEMINI_API_KEY=mock_gemini_api_key1,mock_gemini_api_key2,mock_gemini_api_key3,.....
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
GROQ_API_KEY=mock_groq_api_key
INTENT_MODEL=openai/gpt-oss-120b

# --- Qdrant Vector Database ---
QDRANT_URL=https://mock-qdrant.example.com
QDRANT_PORT=443
QDRANT_API_KEY=mock_qdrant_api_key
QDRANT_COLLECTION_NAME=egyptian_law_scraped

# --- Embedding ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu             # cpu | cuda

# --- Hybrid RAG ---
VECTOR_WEIGHT=0.8
BM25_WEIGHT=0.2
RETRIEVAL_K=4
MAX_FRONTEND_SOURCES=7

# --- Redis Cache ---
REDIS_URL=""